{
  "name": "marketing-simplified-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:ci": "NODE_ENV=test jest --ci --coverage --watchAll=false",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "test:e2e": "playwright test",
    "test:e2e:budget": "playwright test --project=budget-e2e --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cypress": "cypress run",
    "test:e2e:cypress:open": "cypress open",
    "lighthouse:local": "node scripts/lhci-run.cjs"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix --cache"
    ],
    "*.ts": [
      "eslint --fix --cache"
    ],
    "*.tsx": [
      "eslint --fix --cache"
    ],
    "*.json": [
