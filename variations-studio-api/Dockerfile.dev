# Development image for the Variations Studio API (MED-354 spike).
FROM node:20-bullseye

WORKDIR /app

# Same as frontend/Dockerfile.dev: run as `node` with the host UID/GID.
ARG HOST_UID=1000
ARG HOST_GID=1000
RUN if [ "$HOST_UID" != "$(id -u node)" ] || [ "$HOST_GID" != "$(id -g node)" ]; then \
      groupmod -o -g "$HOST_GID" node && usermod -o -u "$HOST_UID" -g "$HOST_GID" node; \
    fi
RUN mkdir -p /app/.next && chown -R node:node /app/.next

COPY --chown=node:node . /app
RUN chown node:node /app

USER node
RUN npm install

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3010
ENV HOSTNAME=0.0.0.0
EXPOSE 3010

CMD ["npm", "run", "dev"]
