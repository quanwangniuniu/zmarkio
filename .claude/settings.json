{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(docker compose:*)",
      "Bash(docker exec:*)",
      "Bash(docker ps:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git check-ignore:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "WebSearch"
    ],
    "deny": [
      "Bash(git add)",
      "Bash(git add:*)",
      "Bash(git stage)",
      "Bash(git stage:*)",
      "Bash(git rm:*)",
      "Bash(git mv:*)",
      "Bash(git reset)",
      "Bash(git reset:*)",
      "Bash(git restore)",
      "Bash(git restore:*)",
      "Bash(git checkout)",
      "Bash(git checkout:*)",
      "Bash(git switch)",
      "Bash(git switch:*)",
      "Bash(git clean)",
      "Bash(git clean:*)",
      "Bash(git stash)",
      "Bash(git stash:*)",
      "Bash(git apply:*)",
      "Bash(git am:*)",
      "Bash(git read-tree:*)",
      "Bash(git update-index:*)",
      "Bash(git commit)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-bash.sh"
          }
        ]
      }
    ]
  }
}
