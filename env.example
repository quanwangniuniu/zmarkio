# IMPORTANT: INFLUXDB_TOKEN must be generated after InfluxDB is first started
# DO NOT commit real tokens to the repository. Use placeholder below.
# 
# To generate the token:
# 1. Start InfluxDB: docker-compose -f docker-compose.dev.yml up -d influxdb
# 2. Wait for InfluxDB to be ready (about 10-15 seconds)
# 3. Generate token: docker exec influxdb-k6 influx auth create --org k6 --all-access --description "K6 Load Testing Token"
# 4. Copy the token from the output and replace <generate-token-using-command-above> below
#
INFLUXDB_TOKEN=<generate-token-using-command-above>

K6_USE_CUSTOM_IMAGE=true

# Chat realtime delivery tuning
# Keep realtime traffic isolated from the default Celery queue. Increase these
# only after checking worker CPU/memory and Redis latency under load.
CHAT_FANOUT_CONCURRENCY=25
CHAT_SUBSCRIPTION_THREAD_CALL_TIMEOUT_SECONDS=5
CHAT_REALTIME_WORKER_CONCURRENCY=4
CHAT_BACKGROUND_WORKER_CONCURRENCY=2

# How long a queued realtime message survives in the channel layer. Past this,
# channels_redis deletes it with no log and no error, while its MessageStatus
# row already reads delivered — so nothing resends it. Raising it does not fix
# an overload, it only widens the burst a slow consumer can drain before
# delivery starts losing messages.
#
# The sweep runs on the publishing side, so the Celery chat workers have to be
# restarted for a change here to take effect, not just the web process.
CHANNEL_LAYER_EXPIRY=300

# Reconnect replays messages already marked delivered, to cover exactly the
# window above. Keep the window at or above CHANNEL_LAYER_EXPIRY; below it, a
# message can be discarded after being recorded as delivered and never resent.
# Anything the client already holds is discarded by message id on arrival.
CHAT_RECONNECT_REPLAY_SECONDS=300
CHAT_RECONNECT_REPLAY_MAX_MESSAGES=100

# Notification SSE replay protection
# Old cursors are replayed in bounded batches. Limit repeated replay attempts
# per authenticated user in a rolling window so reconnect storms cannot issue
# unbounded database work; tune these values after load testing.
NOTIFICATION_SSE_REPLAY_BATCH_SIZE=500
NOTIFICATION_SSE_REPLAY_RATE_LIMIT=5
NOTIFICATION_SSE_REPLAY_RATE_WINDOW_SECONDS=30

# Database request admission control (per web process)
# Caps the number of simultaneous database-touching HTTP requests each Daphne/
# Gunicorn process will accept. Extra requests queue for up to TIMEOUT seconds
# before returning 503. This is a per-process safety valve; PgBouncer provides
# the cluster-wide connection pool.
DATABASE_REQUEST_CONCURRENCY=20
DATABASE_REQUEST_QUEUE_TIMEOUT_SECONDS=30

# PgBouncer connection pooler
# The application containers connect to the PgBouncer service on its internal
# port 5432. These variables only control PgBouncer's upstream PostgreSQL
# connection. Development defaults to the host PostgreSQL instance; the
# single-host production compose defaults to its bundled `db` service.
# PGBOUNCER_DB_HOST=host.docker.internal
# PGBOUNCER_DB_PORT=5432
# Only set this for an upstream PostgreSQL older than 14 that still authenticates
# with md5. The Compose default is scram-sha-256, which is what 14+ uses.
# PGBOUNCER_AUTH_TYPE=md5

# ELK Stack Configuration
ELASTICSEARCH_HOST=http://localhost:9200
KIBANA_HOST=http://localhost:5601
LOG_RETENTION_DAYS=7

# Stripe Configuration
# Shared Test Keys for Development
STRIPE_SECRET_KEY=sk_test_... # The shared test key
STRIPE_PUBLISHABLE_KEY=pk_test_... # The shared test key
STRIPE_WEBHOOK_SECRET=whsec_... # Must generally be replaced by your local CLI secret. See backend/stripe_meta/README.md


# Zoom OAuth Configuration
# Create a General App (NOT Server-to-Server) at https://marketplace.zoom.us/develop/apps
# Add redirect URI: http://localhost/api/v1/zoom/callback/
# Required scopes: meeting:write:meeting, user:read:user
# Post-meeting sync (Celery): add meeting:read, report:read:admin or report:read, cloud_recording:read:admin,
# meeting_summary:read (exact names depend on Zoom Marketplace; reconnect after scope changes).
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_REDIRECT_URI=http://localhost/api/v1/zoom/callback/
# Webhooks: set Event notification URL to https://<host>/api/v1/zoom/webhook/ in Zoom Marketplace.
# Subscribe to P0: meeting.ended, recording.completed; P1: recording.transcript_completed (confirm name), meeting.summary_completed.
ZOOM_WEBHOOK_SECRET_TOKEN=

